# ---------------------------------------------------------------------------
# Ceylon Trip Planners — Environment Variables (template)
# Copy to .env and fill in real values.
# ---------------------------------------------------------------------------

# Database (Neon Postgres)
DATABASE_URL=""
DIRECT_URL=""

# Auth (NextAuth v5)  — generate with: openssl rand -base64 32
AUTH_SECRET=""
NEXTAUTH_URL="http://localhost:3000"
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# Cloudinary
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_UPLOAD_PRESET="ceylon_unsigned"

# Email (MailerSend)
MAILERSEND_API_KEY=""
MAIL_FROM_EMAIL="noreply@ceylontripplanners.com"
MAIL_FROM_NAME="Ceylon Trip Planners"
ADMIN_NOTIFY_EMAIL="info@ceylontripplanners.com"

# Site
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
NEXT_PUBLIC_GOOGLE_MAPS_KEY=""
